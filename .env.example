# Copy this file to ".env" (same directory as docker-compose.yml) before running
# `docker compose up --build`. Never commit the real ".env" file — only this example is tracked.

# ---- Database ----
POSTGRES_DB=assignmenthub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ---- JWT ----
# Generate a real secret locally, e.g.: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# ---- CORS ----
# The frontend's own origin, as the browser sees it (used by the backend's CORS policy).
FRONTEND_ORIGIN=http://localhost:3000

# ---- Frontend ----
# The backend's origin as the BROWSER sees it (baked into the frontend bundle at build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
